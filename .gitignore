# Legacy reference apps (development use only)
Digital-dairy-platform/
PPI_Digital-Interface/

# Output files (regenerated by model runs)
milk-spoilage-model/output/*.csv

# Docker build context assembled by dairy-api/build.sh -- copies of tracked
# files from elsewhere in the repo, so committing them would fork the originals
dairy-api/models/
dairy-api/milk-spoilage-model/
dairy-api/guidance/

# Stamped by dairy-api/deploy_space.py with the digest of the payload it uploads.
# It identifies a deployment, not a checkout, so it belongs to the Space.
dairy-api/build_info.json

# R session files
.Rhistory
.RData
.Rproj.user/

# Python
__pycache__/
*.pyc

# Raw machine records behind the committed transcripts -- Claude Code session
# JSONLs and rig call logs. They carry local paths, so they stay out of the
# public repo; the rendered transcripts beside them are the citable record.
docs/demonstration/transcripts/raw-sessions/

# Internal development docs -- agent instructions, the task board, the domain
# glossary, and early design plans/specs. Kept locally, out of the public repo.
# (.claude-plugin/ at the root is the published marketplace manifest and stays.)
CLAUDE.md
KANBAN.md
CONTEXT.md
.claude/
docs/agents/
docs/superpowers/

# Full-text PDFs read while writing the paper. Third-party publisher content, and
# this repo goes public at publication -- see docs/reference/README.md on
# redistribution. paper/ref/README.md is tracked and records what is there.
paper/ref/*.pdf
paper/ref/*.txt
paper/ref/*.html

# Annotated drafts returned by co-authors, and anything derived from them. Same
# reason as paper/ref, plus one of its own: review comments are written to the
# author in private and name other people. This repo goes public, so they stay
# out of it. The revisions they produced are in main.tex and on issue #13.
paper/review/

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/ref/*.docx
